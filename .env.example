# Public URL of the deployed site (marketing/landing pages).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Database and storage (Supabase now; plain Postgres / local disk later) ---
DATABASE_SESSION_POOL_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_PROJECT_URL=https://<ref>.supabase.co
DATABASE_SERVICE_ROLE_KEY=
BLOB_STORE=local            # local | supabase

# --- LLM (off | replay | live). Keep "off" or "replay" during development. ---
LLM_MODE=off
LLM_PRIMARY=deepseek        # deepseek | groq
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
GROQ_API_KEY=

# --- Search and performance ---
SERPER_API_KEY=
SERP_API_KEY=
PAGE_SPEED_API_KEY=

# --- Execution ---
DEPLOY_TARGET=local         # local | vercel
RUNNER=inline               # inline | worker | http
APP_BASE_URL=http://127.0.0.1:8000
INTERNAL_SECRET=            # required when RUNNER=http
ENGINE_API_KEY=             # required outside local

# Local login, or an explicitly enabled Vercel preview behind Vercel Authentication.
# Production deployments always disable this account.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
DEMO_SESSION_SECRET=
PREVIEW_DEMO_AUTH=          # set to enabled only for a protected Vercel preview
# Vercel sets VERCEL_URL / VERCEL_ENV and, when configured in Deployment Protection,
# VERCEL_AUTOMATION_BYPASS_SECRET. Do not expose the bypass secret to the browser.
RENDERER_URL=               # empty = rendering skipped
